[Unit]
Description=HeiGate Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=heigate
Group=heigate
WorkingDirectory=/opt/heigate
ExecStart=/opt/heigate/datamanagementd \
  -socket-path /tmp/heigate-datamanagement.sock \
  -sqlite-path /var/lib/heigate/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
