#!/bin/sh
set -eu

APP_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
DATA_ROOT="${DATA_DIR:-$HOME/Library/Application Support/HeiGate}"
mkdir -p "$DATA_ROOT"

export DESKTOP_ONLY=true
export DESKTOP_SERVER_HOST="${DESKTOP_SERVER_HOST:-127.0.0.1}"
export DESKTOP_SERVER_PORT="${DESKTOP_SERVER_PORT:-18080}"
export DATA_DIR="$DATA_ROOT"

"$APP_ROOT/Contents/MacOS/heigate-desktop-bin" "$@" &
SERVER_PID=$!

cleanup() {
	kill "$SERVER_PID" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

for _ in $(seq 1 40); do
	if curl -fsS "http://${DESKTOP_SERVER_HOST}:${DESKTOP_SERVER_PORT}/health" >/dev/null 2>&1; then
		open "http://${DESKTOP_SERVER_HOST}:${DESKTOP_SERVER_PORT}/desktop"
		break
	fi
	sleep 0.25
done

wait "$SERVER_PID"
