{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeiGate",
  "version": "2.0.0",
  "identifier": "com.heigate.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
